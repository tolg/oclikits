#!/bin/zsh

SCRIPT_DIR="${0:A:h}"
if [[ -f "${SCRIPT_DIR}/../lib/aicli.sh" ]]; then
  source "${SCRIPT_DIR}/../lib/aicli.sh"
elif [[ -f "${HOME}/.local/lib/aiclikits/aicli.sh" ]]; then
  source "${HOME}/.local/lib/aiclikits/aicli.sh"
else
  echo "❌ 找不到 aicli.sh（请重新运行安装脚本 ./install.sh）" 1>&2
  exit 1
fi

QUERY="$*"
if [[ -z "$QUERY" ]]; then
  echo "用法: aish <自然语言指令>"
  exit 1
fi

OS_INFO=$(uname -s)
SHELL_INFO=$(basename "$SHELL")

SYSTEM_PROMPT="You are a strict command-line translator for $OS_INFO ($SHELL_INFO).
RULES:
1. Output ONLY the raw executable command string.
2. DO NOT include markdown code blocks (\`\`\`).
3. DO NOT output multiple options. Decide on the Single Best One.
4. DO NOT include any explanations or conversational text.
5. If multiple steps are required, combine them using '&&' or '|' or ';'.
6. Your output will be directly executed by 'eval'. Any non-code text will cause a crash."

MODEL="$(aicli_model_for shell qwen3-coder-flash-2025-07-28)"
TEMPERATURE="$(aicli_temperature)"

echo -n "🤖 Thinking...\r"
CONTENT=$(aicli_chat "$MODEL" "$SYSTEM_PROMPT" "$QUERY" "$TEMPERATURE") || exit 1

CMD=$(printf '%s' "$CONTENT" \
  | sed 's/^```.*//g' \
  | sed 's/```$//g' \
  | sed 's/^`//g' \
  | sed 's/`$//g' \
  | awk 'NF' \
  | head -n 1)

if [[ -z "$CMD" ]]; then
  echo -e "\n❌ 解析为空"
  exit 1
fi

echo -ne "\033[2K\r"
echo "----------------------------------------"
echo -e "\033[1;32m$CMD\033[0m"
echo "----------------------------------------"

echo -n "执行? [Y/n] "
read -k 1 ACTION
ENTER_KEY=$'\n'
if [[ "$ACTION" != "n" && "$ACTION" != "N" ]]; then
  if [[ "$ACTION" != "$ENTER_KEY" ]]; then
    echo ""
  fi
  print -s "$CMD"
  eval "$CMD"
else
  echo ""
  echo "已取消。"
fi
